{$P18_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 25MB
    }
    reverse_proxy 127.0.0.1:8896 {
        header_up Host {$P18_DOMAIN}
        header_up X-Forwarded-Proto {scheme}
        header_up X-P18-Remote-IP {remote_host}
        transport http {
            response_header_timeout 600s
        }
    }
    log {
        output stdout
        format json
    }
}
